    fields.SubscriptionEndDate = start ? formatLongDate(_addMonths(start, term)) : term + ' months from go-live';
    fields.RenewalTerm = term + ' months';
    fields.AutoRenewal = _yesNo(com.autoRenew !== false);
    fields.BillingCycle = _v(com.billingCycle || 'Annual');
    fields.PaymentMethod = _v(com.paymentMethod || 'Bank Transfer');
    fields.PONumber = _v(com.poNumber || 'Not applicable');
    fields.MsaRef = _v(com.msaRef);
    fields.SpecialTerms = _v(com.specialTerms || 'None.');
    fields.TotalRecurringMonthly = m(op.recurringMonthly);
    fields.TotalRecurringAnnual = m(op.recurringAnnual);
    fields.TotalOneTime = m(op.oneTimeTotal + quote.optionalOneTimeTotal);
    fields.FirstYearTotal = m(op.firstYearTotal + quote.optionalOneTimeTotal);
    fields.FinalPricePerSite = m(op.finalPricePerSite);

    lists.SubscriptionLines = [{
      product: 'OptCulture ' + op.package + ' Plan – platform licence',
      scope: op.sites + ' sites (' + quote.stores + ' stores' + (quote.ecomSites ? ' + ' + quote.ecomSites + ' e-commerce' : '') + ') @ ' + m(op.finalPricePerSite) + ' / site / month',
      billing: fields.BillingCycle + ', in advance',
      amount: m(op.licenceAnnual) + ' / year'
    }].concat(op.addOns.map(function (a) {
      return { product: a.label, scope: 'Add-on', billing: fields.BillingCycle + ', in advance', amount: m(a.total * 12) + ' / year' };
    }));

    lists.UsageLines = [{
      metric: 'Receipts', included: op.receiptsIncludedPerSite.toLocaleString('en-US') + ' per site / month', rate: m(op.overagePer1000) + ' per additional 1,000'
    }].concat(quote.usage.map(function (l) {
      return { metric: l.label, included: /^COMMS_/.test(l.id) ? Number(l.messages).toLocaleString('en-US') + ' conversations / month' : '—', rate: l.text || (m(l.unitPrice) + ' ' + l.unit) };
    }));

    lists.OneTimeLines = op.oneTime.concat(quote.optionalOneTime).map(function (l) {
      return { description: l.label, scope: l.qty > 1 ? l.qty + ' × ' + m(l.unitPrice) : (l.unit || ''), amount: l.text || m(l.total) };
    });
  }

  if (docType === 'TOS') {
    lists.OptCultureEntities = (master.Entities || []).filter(function (e) { return e.type === 'OptCulture' && isTrue(e.active); })
      .map(function (e) { return { country: e.country, name: e.legal_name }; });
  }

  if (docType === 'DPA') {
    var d = deal.dpa || {};
    var addendum = country.dpa_addendum || '4F';
    ['4A', '4B', '4C', '4D', '4E', '4F'].forEach(function (a) { flags['Addendum' + a] = a === addendum; });
    fields.DpaAddendum = addendum;
    fields.HostingRegion = _v(d.hostingRegion || terms.default_hosting_region || 'To be confirmed');
    fields.ExtraDataSubjects = d.extraDataSubjects ? '; ' + d.extraDataSubjects : '';
    fields.ExtraDataTypes = d.extraDataTypes ? '; ' + d.extraDataTypes : '';
    fields.SensitiveData = _v(d.sensitiveData || 'None');
    var platform = (master.Entities || []).filter(function (e) { return e.entity_id === (d.platformEntityId || 'OC-US'); })[0] || {};
    fields.PlatformEntityName = _v(platform.legal_name);
    fields.PlatformEntityCountry = _v(platform.country);
    lists.SubProcessors = (isPartner ? [{ name: platform.legal_name, service: 'Operation of the OptCulture platform', location: platform.country }] : [])
      .concat((master.SubProcessors || []).filter(function (s) { return isTrue(s.active); })
        .sort(function (a, b) { return a.display_order - b.display_order; })
        .map(function (s) { return { name: s.name, service: s.service + (s.condition ? ' (' + s.condition + ')' : ''), location: s.location }; }));
  }

  return { docType: docType, fields: fields, flags: flags, lists: lists, tables: tables, texts: texts, images: images, style: style };
}

/** Required inputs per document; returns missing-field messages. */
function missingForDoc(docType, deal) {
  var c = deal.client || {}, com = deal.commercial || {};
  var req = {
    PROPOSAL: [[c.legalName, 'Client legal name'], [c.country, 'Country']],
    ORDER_FORM: [[c.legalName, 'Client legal name'], [c.address, 'Registered address'], [c.businessContact && c.businessContact.email, 'Business contact email'],
      [c.billingContact && c.billingContact.email, 'Billing contact email'], [deal.entityId, 'Contracting entity / partner'], [com.termMonths, 'Subscription term']],
    TOS: [[c.legalName, 'Client legal name'], [deal.entityId, 'Contracting entity / partner']],
    DPA: [[c.legalName, 'Client legal name'], [c.address, 'Registered address'], [c.country, 'Country'], [deal.entityId, 'Contracting entity / partner']]
  }[docType] || [];
  return req.filter(function (r) { return !r[0]; }).map(function (r) { return r[1]; });
}

/** Find every {{…}} token in template text and report ones the data cannot fill. */
function checkTemplateTokens(text, data) {
  var tokens = (String(text).match(/\{\{[^}]+\}\}/g) || []).map(function (t) { return t.slice(2, -2).trim(); });
  var unknown = [];
  var listKeys = {};
  Object.keys(data.lists).forEach(function (k) { (data.lists[k] || []).forEach(function (it) { Object.keys(it).forEach(function (kk) { listKeys[kk] = true; }); }); });
  tokens.forEach(function (t) {
    var ok;
    var mIf = t.match(/^[#\/]IF\s+!?(\w+)$/);
    var mTag = t.match(/^(EACH|LIST|TABLE|TEXT|IMAGE):(\w+)$/);
    if (mIf) ok = mIf[1] in data.flags;
    else if (mTag) ok = mTag[1] === 'IMAGE' ? ['OptCultureLogo', 'EntityLogo'].indexOf(mTag[2]) !== -1 : { EACH: data.lists, LIST: data.lists, TABLE: data.tables, TEXT: data.texts }[mTag[1]].hasOwnProperty(mTag[2]);
    else ok = t in data.fields || t in listKeys;
    if (!ok && unknown.indexOf(t) === -1) unknown.push(t);
  });
  return unknown;
}

// ===================== DealLogic.js =====================
/**
 * Sprint 6: deal rules. Pure JS (Apps Script + Node tests).
 *
 * deal = {
 *   dealId, version, status,
 *   client: {...}, entityId,
 *   commercial: {...},                        // see Pricing.js / DocData.js
 *   docs: { PROPOSAL: true, ORDER_FORM: true, TOS: true, DPA: true },
 *   language: 'EN' | 'AR' | 'BI',
 *   proposal: { title, tagline, multiBrand, showConsulting },
 *   narrative: { notes, executiveSummary, journeys: [], multiBrandIntro },
 *   dpa: { hostingRegion, extraDataSubjects, extraDataTypes, sensitiveData }
 * }
 */

var DEAL_STATUS = { DRAFT: 'Draft', PENDING: 'Pending approval', APPROVED: 'Approved', REJECTED: 'Rejected', GENERATED: 'Generated', WON: 'Won', LOST: 'Lost' };

/** Fill market / currency / contracting entity from the Countries tab when the rep has not chosen them. */
function applyCountryDefaults(master, deal) {
  deal.commercial = deal.commercial || {};
  var country = (master.Countries || []).filter(function (r) { return r.country === (deal.client || {}).country; })[0];
  if (!country) return deal;
  if (!deal.commercial.market) deal.commercial.market = country.default_market;
  if (!deal.commercial.currency) deal.commercial.currency = country.default_currency;
  if (!deal.entityId && country.entity_id) deal.entityId = country.entity_id;
  return deal;
}

function selectedDocs(deal) {
  var d = deal.docs || {};
  return DOC_TYPES.filter(function (t) { return d[t]; });
}

/** Full check of a deal: quote, blocking errors, missing fields per selected document, approval need. */
function evaluateDeal(master, deal) {
  var errors = [];
  var c = deal.client || {}, com = deal.commercial || {};
  if (!c.legalName) errors.push('Client legal name is required');
  if (!c.country) errors.push('Country is required');
  var docs = selectedDocs(deal);
  if (!docs.length) errors.push('Select at least one document');
  if (deal.entityId && !(master.Entities || []).some(function (e) { return e.entity_id === deal.entityId; })) errors.push('Unknown contracting entity');
  if (docs.indexOf('ORDER_FORM') !== -1 && com.orderPackage && (com.packages || []).indexOf(com.orderPackage) === -1) {
    errors.push('Order Form package must be one of the quoted packages');
  }
  var c1 = c.businessContact || {}, c2 = c.billingContact || {};
  [c1.email, c2.email].forEach(function (e) { if (e && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(e)) errors.push('Invalid email: ' + e); });

  var quote = buildQuote(master, com);
  if (!quote.ok) errors = errors.concat(quote.errors);

  var missing = {};
  docs.forEach(function (t) { var mm = missingForDoc(t, deal); if (mm.length) missing[t] = mm; });

  return {
    ok: errors.length === 0,
    errors: errors,
    quote: quote.ok ? quote : null,
    missing: missing,
    readyToGenerate: errors.length === 0 && Object.keys(missing).length === 0,
    needsApproval: quote.ok ? quote.needsApproval : false,
    approvalReasons: quote.ok ? quote.approvalReasons : []
  };
}

/** May this user see / edit a deal owned by ownerEmail? Superadmin: all. Owner: yes. Manager: own team. */
function canAccessDeal(user, ownerEmail, users) {
  if (!user || !user.ok) return false;
  var owner = String(ownerEmail || '').toLowerCase();
  if (user.role === 'Superadmin') return true;
  if (owner === user.email) return true;
  if (user.role === 'Manager') {
    return (users || []).some(function (u) {
      return String(u.email).toLowerCase() === owner && String(u.manager_email).toLowerCase() === user.email;
    });
  }
  return false;
}

/** Build the Deals-tab record for a deal. */
function dealRecord(deal, evaluation, userEmail, nowIso, existing) {
  var com = deal.commercial || {};
  return {
    deal_id: deal.dealId,
    created_at: existing ? existing.created_at : nowIso,
    created_by: existing ? existing.created_by : userEmail,
    updated_at: nowIso,
    status: deal.status || DEAL_STATUS.DRAFT,
    client_id: deal.clientId || '',
    client_name: (deal.client || {}).legalName || '',
    country: (deal.client || {}).country || '',
    market: com.market || '',
    currency: com.currency || '',
    entity_id: deal.entityId || '',
    stores: Number(com.stores || 0),
    ecom_sites: Number(com.ecomSites || 0),
    packages: (com.packages || []).join(', '),
    input_json: JSON.stringify(deal),
    quote_json: evaluation.quote ? JSON.stringify(evaluation.quote) : '',
    needs_approval: !!evaluation.needsApproval,
    approval_status: evaluation.needsApproval ? (existing && existing.approval_status === 'Approved' && existing.quote_json === JSON.stringify(evaluation.quote) ? 'Approved' : 'Required') : 'Not required',
    ai_draft_json: existing ? existing.ai_draft_json : '',
    final_text_json: JSON.stringify(deal.narrative || {}),
    version: Number(deal.version || 1)
  };
}

/** Summary row for deal lists (no heavy JSON). */
function dealSummary(rec) {
  return {
    dealId: rec.deal_id, clientName: rec.client_name, country: rec.country, packages: rec.packages,
    currency: rec.currency, status: rec.status, needsApproval: isTrue(rec.needs_approval), approvalStatus: rec.approval_status,
    createdBy: rec.created_by, updatedAt: rec.updated_at instanceof Date ? rec.updated_at.toISOString() : String(rec.updated_at || ''),
    version: Number(rec.version || 1)
  };
}

/** Copy of a deal as a new draft (new id, version 1, status Draft). */
function cloneDeal(deal, newId) {
  var c = JSON.parse(JSON.stringify(deal));
  c.dealId = newId;
  c.version = 1;
  c.status = DEAL_STATUS.DRAFT;
  c.client = c.client || {};
  return c;
}

// ===================== MasterData.js =====================
/** Reads the Master Sheet into { TabName: [objects] } with a short cache. */

function getMasterSpreadsheet_() {
  var id = getProp_('MASTER_SHEET_ID');
  if (!id) throw new Error('Master Sheet not set up yet. Run setupMasterSheet() first.');
  return SpreadsheetApp.openById(id);
}

function readTable_(ss, tab) {
  var sh = ss.getSheetByName(tab);
  if (!sh || sh.getLastRow() < 1) return [];
  var values = sh.getDataRange().getValues();
  var headers = values.shift();
  return values
    .filter(function (r) { return r.join('') !== ''; })
    .map(function (r) { var o = {}; headers.forEach(function (h, i) { o[h] = r[i]; }); return o; });
}

/** All master tabs (cached). Pass true to bypass the cache, e.g. after an admin edit. */
function getMaster(noCache) {
  var cache = CacheService.getScriptCache();
  if (!noCache) {
    var hit = cache.get('MASTER');
    if (hit) return JSON.parse(hit);
  }
  var ss = getMasterSpreadsheet_();
  var m = {};
  Object.keys(SEED).forEach(function (tab) {
    if (SEED[tab].kind === 'master') m[tab] = readTable_(ss, tab);
  });
  try { cache.put('MASTER', JSON.stringify(m), CONFIG.CACHE_SECONDS); } catch (e) { /* >100KB: skip caching */ }
  return m;
}

function clearMasterCache() {
  CacheService.getScriptCache().remove('MASTER');
}

/** Append a record row by header names. */
function appendRecord_(tab, obj) {
  var sh = getMasterSpreadsheet_().getSheetByName(tab);
  var headers = SEED[tab].headers;
  sh.appendRow(headers.map(function (h) { return obj[h] === undefined ? '' : obj[h]; }));
}

function audit_(action, details, dealId, docNo) {
  try {
    appendRecord_('AuditLog', {
      timestamp: new Date(), user_email: Session.getActiveUser().getEmail(),
      action: action, deal_id: dealId || '', doc_no: docNo || '',
      details: typeof details === 'string' ? details : JSON.stringify(details || {})
    });
  } catch (e) { console.error('audit failed', e); }
}

// ===================== Auth.js =====================
/** Sprint 1.3: authentication and roles. Every API call must go through requireUser_(). */

function getCurrentUser() {
  var email = String(Session.getActiveUser().getEmail() || '').toLowerCase();
  if (!email) return { ok: false, reason: 'Could not read your Google account. Please sign in with your @' + CONFIG.ALLOWED_DOMAIN + ' account.' };
  if (email.split('@')[1] !== CONFIG.ALLOWED_DOMAIN) return { ok: false, email: email, reason: 'Only @' + CONFIG.ALLOWED_DOMAIN + ' accounts can use this app.' };
  var u = (getMaster().Users || []).filter(function (r) { return String(r.email).toLowerCase() === email; })[0];
  if (!u || !isTrue(u.active)) return { ok: false, email: email, reason: 'Your account is not set up yet. Please ask Amith (superadmin) to add you.' };
  return { ok: true, email: email, name: u.name, role: u.role, managerEmail: u.manager_email, region: u.region, phone: u.phone };
}

function requireUser_(allowedRoles) {
  var u = getCurrentUser();
  if (!u.ok) throw new Error(u.reason);
  if (allowedRoles && allowedRoles.indexOf(u.role) === -1) throw new Error('You do not have permission for this action.');
  return u;
}

/** Emails a user may see records for: own (Rep), own + team (Manager), all (Superadmin => null). */
function visibleOwners_(user) {
  if (user.role === CONFIG.ROLES.SUPERADMIN) return null;
  var emails = [user.email];
  if (user.role === CONFIG.ROLES.MANAGER) {
    (getMaster().Users || []).forEach(function (r) {
      if (String(r.manager_email).toLowerCase() === user.email) emails.push(String(r.email).toLowerCase());
    });
  }
  return emails;
}

// ===================== Numbering.js =====================
/**
 * Sprint 4: document numbers OC-P-2026-0001 etc. Uses a script lock so two reps never get the same number.
 * The counter resets each calendar year.
 */
function nextDocNo(docType) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var sh = getMasterSpreadsheet_().getSheetByName('Numbering');
    var values = sh.getDataRange().getValues();
    var h = values[0];
    var iType = h.indexOf('doc_type'), iPrefix = h.indexOf('prefix'), iYear = h.indexOf('year'), iLast = h.indexOf('last_no');
    var year = new Date().getFullYear();
    for (var r = 1; r < values.length; r++) {
      if (values[r][iType] !== docType) continue;
      var last = Number(values[r][iYear]) === year ? Number(values[r][iLast]) : 0;
      var next = last + 1;
      sh.getRange(r + 1, iYear + 1).setValue(year);
      sh.getRange(r + 1, iLast + 1).setValue(next);
      SpreadsheetApp.flush();
      return values[r][iPrefix] + '-' + year + '-' + ('000' + next).slice(-4);
    }
    throw new Error('No numbering row for ' + docType);
  } finally {
    lock.releaseLock();
  }
}

// ===================== Deals.js =====================
/**
 * Sprint 6: deal storage in the Master Sheet (Deals + Clients tabs) and the client-callable deal API.
 * Every API re-checks the signed-in user's role and ownership on the server.
 */

function readRecords_(tab) {
  var sh = getMasterSpreadsheet_().getSheetByName(tab);
  var values = sh.getDataRange().getValues();
  var headers = values.shift();
  return values.map(function (r, i) {
    var o = { _row: i + 2 };
    headers.forEach(function (h, j) { o[h] = r[j]; });
    return o;
  }).filter(function (o) { return o[headers[0]] !== ''; });
}

function writeRecord_(tab, obj, rowNumber) {
  var sh = getMasterSpreadsheet_().getSheetByName(tab);
  var headers = SEED[tab].headers;
  var row = headers.map(function (h) { return obj[h] === undefined ? '' : obj[h]; });
  if (rowNumber) sh.getRange(rowNumber, 1, 1, headers.length).setValues([row]);
  else sh.appendRow(row);
}

function newId_(prefix) {
  return prefix + '-' + Utilities.formatDate(new Date(), 'Asia/Dubai', 'yyMMdd-HHmmss') + '-' + Math.floor(Math.random() * 900 + 100);
}

function findDeal_(dealId) {
  return readRecords_('Deals').filter(function (r) { return r.deal_id === dealId; })[0] || null;
}

function upsertClient_(deal, userEmail) {
  var c = deal.client || {};
  if (!c.legalName) return '';
  var existing = readRecords_('Clients').filter(function (r) {
    return r.client_id === deal.clientId || String(r.legal_name).toLowerCase() === String(c.legalName).toLowerCase();
  })[0];
  var rec = {
    client_id: existing ? existing.client_id : newId_('C'),
    legal_name: c.legalName, short_name: c.shortName || '', country: c.country || '', address: c.address || '',
    reg_type: c.regType || '', reg_no: c.regNo || '', website: c.website || '', brands: c.brands || '', pos: c.pos || '',
    ecom_platform: c.ecomPlatform || '', business_contact: JSON.stringify(c.businessContact || {}),
    billing_contact: JSON.stringify(c.billingContact || {}),
    owner_email: existing ? existing.owner_email : userEmail, created_at: existing ? existing.created_at : new Date()
  };
  writeRecord_('Clients', rec, existing ? existing._row : null);
  return rec.client_id;
}

// ---------------- API (google.script.run) ----------------

/** Lists for the deal form. */
function apiFormLists() {
  var user = requireUser_();
  var m = getMaster();
  return {
    countries: m.Countries,
    entities: m.Entities.filter(function (e) { return isTrue(e.active); }).map(function (e) { return { id: e.entity_id, name: e.legal_name, type: e.type, country: e.country }; }),
    commsTiers: (m.CommsTiers || []).filter(function (t) { return isTrue(t.active); }).map(function (t) { return { id: t.tier_id, messages: t.messages, label: t.label }; }),
    clients: readRecords_('Clients').filter(function (r) { return canAccessDeal(user, r.owner_email, m.Users); }).map(function (r) {
      return { clientId: r.client_id, legalName: r.legal_name, shortName: r.short_name, country: r.country, address: r.address,
        regType: r.reg_type, regNo: r.reg_no, website: r.website, brands: r.brands, pos: r.pos, ecomPlatform: r.ecom_platform,
        businessContact: safeJson_(r.business_contact), billingContact: safeJson_(r.billing_contact) };
    })
  };
}

function safeJson_(s) { try { return JSON.parse(s || '{}'); } catch (e) { return {}; } }

/** Live check while the rep fills the form (no saving). */
function apiEvaluateDeal(deal) {
  requireUser_();
  var m = getMaster();
  applyCountryDefaults(m, deal);
  return { deal: deal, evaluation: evaluateDeal(m, deal) };
}

/** Save (create or update) a draft. Returns the saved deal and its evaluation. */
function apiSaveDeal(deal) {
  var user = requireUser_();
  var m = getMaster();
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    applyCountryDefaults(m, deal);
    var existing = deal.dealId ? findDeal_(deal.dealId) : null;
    if (deal.dealId && !existing) throw new Error('Deal not found: ' + deal.dealId);
    if (existing && !canAccessDeal(user, existing.created_by, m.Users)) throw new Error('You do not have access to this deal.');
    if (existing && [DEAL_STATUS.DRAFT, DEAL_STATUS.REJECTED, DEAL_STATUS.APPROVED, DEAL_STATUS.PENDING].indexOf(existing.status) === -1) {
      // Generated / Won / Lost deals are revised as a new version
      deal.version = Number(existing.version || 1) + 1;
      deal.status = DEAL_STATUS.DRAFT;
    }
    if (!deal.dealId) { deal.dealId = newId_('D'); deal.version = 1; deal.status = DEAL_STATUS.DRAFT; }
    deal.clientId = upsertClient_(deal, user.email) || deal.clientId || '';
    var ev = evaluateDeal(m, deal);
    var rec = dealRecord(deal, ev, user.email, new Date().toISOString(), existing);
    writeRecord_('Deals', rec, existing ? existing._row : null);
    audit_(existing ? 'DEAL_UPDATED' : 'DEAL_CREATED', { version: deal.version, needsApproval: ev.needsApproval }, deal.dealId);
    return { deal: deal, evaluation: ev, summary: dealSummary(rec) };
  } finally {
    lock.releaseLock();
  }
}

function apiListDeals() {
  var user = requireUser_();
  var users = getMaster().Users;
  return readRecords_('Deals')
    .filter(function (r) { return canAccessDeal(user, r.created_by, users); })
    .map(dealSummary)
    .sort(function (a, b) { return a.updatedAt < b.updatedAt ? 1 : -1; });
}

function apiGetDeal(dealId) {
  var user = requireUser_();
  var rec = findDeal_(dealId);
  if (!rec || !canAccessDeal(user, rec.created_by, getMaster().Users)) throw new Error('Deal not found or no access.');
  var deal = JSON.parse(rec.input_json);
  deal.status = rec.status;
  return { deal: deal, evaluation: evaluateDeal(getMaster(), deal), summary: dealSummary(rec) };
}

function apiCloneDeal(dealId) {
  var src = apiGetDeal(dealId).deal;
  var copy = cloneDeal(src, null);
  copy.dealId = null;
  var res = apiSaveDeal(copy);
  audit_('DEAL_CLONED', { from: dealId }, res.deal.dealId);
  return res;
}

// ===================== DocEngine.js =====================
/**
 * Sprint 4: Google Docs template engine.
 * generateDocument(docType, data, opts) copies the active template, fills it with data from buildDocData(),
 * saves it to the right folder, exports a PDF (unless draft), shares it, and records it in the Documents tab.
 *
 * Template syntax: see docs/PLACEHOLDERS.md.
 */

var DOC_FOLDER_KEY = { PROPOSAL: 'PROPOSALS', ORDER_FORM: 'ORDER_FORMS', TOS: 'LEGAL', DPA: 'LEGAL' };
var DOC_LABEL = { PROPOSAL: 'Proposal', ORDER_FORM: 'Order Form', TOS: 'Terms of Service', DPA: 'DPA' };
var TABLE_STYLE = { headerBg: '#7B3FE4', headerFg: '#ffffff', border: '#c9d2dc', font: 'Arial', size: 10 };

/**
 * @param {string} docType PROPOSAL | ORDER_FORM | TOS | DPA
 * @param {Object} data output of buildDocData()
 * @param {Object} opts { language, clientName, version, draft (bool), shareWith: [emails], templateFileId (override, for tests) }
 * @return {Object} { docId, docUrl, pdfId, pdfUrl, name, warnings }
 */
function generateDocument(docType, data, opts) {
  opts = opts || {};
  var tpl = opts.templateFileId ? { file_id: opts.templateFileId } : getActiveTemplate_(docType, opts.language || 'EN');
  var folder = getOutputFolder_(docType, opts.clientName);
  var name = [data.fields.DocNo, safeName_(opts.clientName), DOC_LABEL[docType], 'v' + (opts.version || 1)].join('_');
  if (opts.draft) name += '_DRAFT';

  var copy = DriveApp.getFileById(tpl.file_id).makeCopy(name, folder);
  var doc = DocumentApp.openById(copy.getId());
  var warnings = [];

  var sections = [doc.getBody()];
  if (doc.getHeader()) sections.push(doc.getHeader());
  if (doc.getFooter()) sections.push(doc.getFooter());

  sections.forEach(function (sec) {
    applyInlineIfs_(sec, data.flags);
    applyBlockIfs_(sec, data.flags);
  });
  var body = doc.getBody();
  applyEachRows_(body, data.lists, warnings);
  applyListParagraphs_(body, data.lists, warnings);
  applyTexts_(body, data.texts);
  applyTables_(body, data.tables, warnings);
  sections.forEach(function (sec) { applyImages_(sec, data.images); });
  sections.forEach(function (sec) {
    Object.keys(data.fields).forEach(function (k) { replaceLiteral_(sec, '{{' + k + '}}', data.fields[k]); });
  });
  styleAllTableHeaders_(body, (data.style && data.style.tableHeaderBg) || TABLE_STYLE.headerBg);
  sections.forEach(function (sec) { warnings = warnings.concat(highlightLeftovers_(sec)); });
  if (opts.draft) addDraftBanner_(doc);
  doc.saveAndClose();

  var result = { docId: copy.getId(), docUrl: copy.getUrl(), pdfId: '', pdfUrl: '', name: name, warnings: warnings };
  if (!opts.draft) {
    var pdf = folder.createFile(copy.getAs(MimeType.PDF)).setName(name + '.pdf');
    result.pdfId = pdf.getId();
    result.pdfUrl = pdf.getUrl();
  }
  shareFiles_([result.docId, result.pdfId].filter(String), opts.shareWith || []);
  return result;
}

// ---------------- templates & folders ----------------

function getActiveTemplate_(docType, lang) {
  var t = (getMaster().Templates || []).filter(function (r) {
    return r.doc_type === docType && String(r.language || 'EN') === lang && isTrue(r.active) && r.file_id;
  })[0];
  if (!t) throw new Error('No active ' + lang + ' template for ' + docType + '. Add one in the Templates tab.');
  return t;
}

function getOutputFolder_(docType, clientName) {
  var baseId = getProp_('FOLDER_' + DOC_FOLDER_KEY[docType]);
  if (!baseId) throw new Error('Folders not set up. Run setupFolders().');
  var year = getOrCreateFolder_(DriveApp.getFolderById(baseId), String(new Date().getFullYear()));
  return getOrCreateFolder_(year, safeName_(clientName) || 'Unnamed client');
}

function safeName_(s) {
  return String(s || '').replace(/[\\\/:*?"<>|#]/g, '').replace(/\s+/g, ' ').trim().slice(0, 80);
}

/** Share each file with the given users (rep, manager). Superadmins get access via Shared Drive membership. */
function shareFiles_(fileIds, emails) {
  fileIds.forEach(function (id) {
    var f = DriveApp.getFileById(id);
    emails.filter(Boolean).forEach(function (e) {
      try { f.addEditor(e); } catch (err) { console.warn('share failed ' + e + ': ' + err); }
    });
  });
}

// ---------------- conditionals ----------------

function _flagValue(flags, expr) {
  var neg = expr.charAt(0) === '!';
  var v = !!flags[neg ? expr.slice(1) : expr];
  return neg ? !v : v;
}

/** {{#IF X}}…{{/IF X}} within a single paragraph. */
function applyInlineIfs_(sec, flags) {
  var re = /\{\{#IF (!?\w+)\}\}/;
  var guard = 0;
  var found;
  while ((found = sec.findText('\\{\\{#IF !?\\w+\\}\\}')) && guard++ < 500) {
    var textEl = found.getElement().asText();
    var str = textEl.getText();
    var start = found.getStartOffset();
    var expr = str.slice(start).match(re)[1];
    var closeTok = '{{/IF ' + expr.replace(/^!/, '') + '}}';
    var openTok = '{{#IF ' + expr + '}}';
    var closeIdx = str.indexOf(closeTok, start);
    if (closeIdx === -1) {
      // block-level IF (closing tag in another paragraph): handled by applyBlockIfs_. Mark to skip.
      textEl.deleteText(start, start + openTok.length - 1);
      textEl.insertText(start, '[[BLOCKIF ' + expr + ']]');
      continue;
    }
    if (_flagValue(flags, expr)) {
      textEl.deleteText(closeIdx, closeIdx + closeTok.length - 1);
      textEl.deleteText(start, start + openTok.length - 1);
    } else {
      textEl.deleteText(start, closeIdx + closeTok.length - 1);
    }
  }
  // restore block markers
  var b;
  while ((b = sec.findText('\\[\\[BLOCKIF !?\\w+\\]\\]'))) {
    var el = b.getElement().asText();
    var s = el.getText().slice(b.getStartOffset(), b.getEndOffsetInclusive() + 1);
    var ex = s.match(/BLOCKIF (!?\w+)/)[1];
    el.deleteText(b.getStartOffset(), b.getEndOffsetInclusive());
    el.insertText(b.getStartOffset(), '{{#IF ' + ex + '}}');
  }
}

/** Paragraph-level {{#IF X}} … {{/IF X}} spanning paragraphs/tables. Marker paragraphs are removed. */
function applyBlockIfs_(sec, flags) {
  var guard = 0;
  while (guard++ < 200) {
    var n = sec.getNumChildren();
    var openIdx = -1, expr = null;
    for (var i = 0; i < n; i++) {
      var m = _childText(sec.getChild(i)).match(/^\s*\{\{#IF (!?\w+)\}\}\s*$/);
      if (m) { openIdx = i; expr = m[1]; break; }
    }
    if (openIdx === -1) return;
    var closeRe = new RegExp('^\\s*\\{\\{/IF ' + expr.replace(/^!/, '') + '\\}\\}\\s*$');
    var closeIdx = -1;
    for (var j = openIdx + 1; j < sec.getNumChildren(); j++) {
      if (closeRe.test(_childText(sec.getChild(j)))) { closeIdx = j; break; }
    }
    if (closeIdx === -1) throw new Error('Template error: {{#IF ' + expr + '}} has no matching {{/IF}}');
    var keep = _flagValue(flags, expr);
    for (var k = closeIdx; k >= openIdx; k--) {
      if (keep && k !== openIdx && k !== closeIdx) continue;
      _removeChild(sec, k);
    }
  }
}

function _childText(el) {
  var t = el.getType();
  return (t === DocumentApp.ElementType.PARAGRAPH || t === DocumentApp.ElementType.LIST_ITEM) ? el.asText().getText() : '';
}

function _removeChild(sec, idx) {
  // Google Docs requires every section to keep a final paragraph and refuses empty text inserts,
  // so when removing the last child we first append a placeholder paragraph containing a space.
  if (idx >= sec.getNumChildren() - 1) sec.appendParagraph(' ');
  sec.getChild(idx).removeFromParent();
}

// ---------------- repeating content ----------------

/** Table rows whose text contains {{EACH:Name}} are repeated once per list item. */
function applyEachRows_(body, lists, warnings) {
  var tables = body.getTables();
  tables.forEach(function (table) {
    for (var r = table.getNumRows() - 1; r >= 0; r--) {
      var row = table.getRow(r);
      var m = row.getText().match(/\{\{EACH:(\w+)\}\}/);
      if (!m) continue;
      var items = lists[m[1]];
      if (!items) { warnings.push('No list data for EACH:' + m[1]); items = []; }
      for (var i = items.length - 1; i >= 0; i--) {
        var newRow = table.insertTableRow(r + 1, row.copy());
        replaceLiteral_(newRow, m[0], '');
        Object.keys(items[i]).forEach(function (k) { replaceLiteral_(newRow, '{{' + k + '}}', items[i][k]); });
      }
      table.removeRow(r);
    }
  });
}

/** Paragraphs / list items containing {{LIST:Name}} are repeated once per item. */
function applyListParagraphs_(body, lists, warnings) {
  var f;
  var guard = 0;
  while ((f = body.findText('\\{\\{LIST:\\w+\\}\\}')) && guard++ < 100) {
    var par = f.getElement().getParent();
    while (par.getType() !== DocumentApp.ElementType.PARAGRAPH && par.getType() !== DocumentApp.ElementType.LIST_ITEM) par = par.getParent();
    var tag = par.asText().getText().match(/\{\{LIST:(\w+)\}\}/);
    var items = lists[tag[1]];
    if (!items) { warnings.push('No list data for LIST:' + tag[1]); items = []; }
    var container = par.getParent();
    var idx = container.getChildIndex(par);
    for (var i = items.length - 1; i >= 0; i--) {
      var copy = par.copy();
      var inserted = par.getType() === DocumentApp.ElementType.LIST_ITEM
        ? container.insertListItem(idx + 1, copy) : container.insertParagraph(idx + 1, copy);
      replaceLiteral_(inserted, tag[0], '');
      Object.keys(items[i]).forEach(function (k) { replaceLiteral_(inserted, '{{' + k + '}}', items[i][k]); });
    }
    _removeChild(container, idx);
  }
}

/** A paragraph containing {{TEXT:Name}} becomes one paragraph per blank-line-separated block (same style). */
function applyTexts_(body, texts) {
  var f;
  var guard = 0;
  while ((f = body.findText('\\{\\{TEXT:\\w+\\}\\}')) && guard++ < 50) {
    var par = f.getElement().getParent();
    while (par.getType() !== DocumentApp.ElementType.PARAGRAPH && par.getType() !== DocumentApp.ElementType.LIST_ITEM) par = par.getParent();
    var key = par.asText().getText().match(/\{\{TEXT:(\w+)\}\}/)[1];
    var parts = String(texts[key] || '').split(/\n\s*\n/).map(function (s) { return s.trim(); }).filter(String);
    var container = par.getParent();
    var idx = container.getChildIndex(par);
    if (!parts.length) { _removeChild(container, idx); continue; }
    for (var i = parts.length - 1; i >= 1; i--) {
      var c = container.insertParagraph(idx + 1, par.copy());
      c.setText(parts[i]);
    }
    par.asParagraph().setText(parts[0]);
  }
}

/** A paragraph containing {{TABLE:Name}} is replaced by a generated, styled table. */
function applyTables_(body, tables, warnings) {
  var f;
  var guard = 0;
  while ((f = body.findText('\\{\\{TABLE:\\w+\\}\\}')) && guard++ < 50) {
    var par = f.getElement().getParent();
    while (par.getType() !== DocumentApp.ElementType.PARAGRAPH) par = par.getParent();
    var key = par.getText().match(/\{\{TABLE:(\w+)\}\}/)[1];
    var t = tables[key];
    var idx = body.getChildIndex(par);
    if (!t) { warnings.push('No table data for TABLE:' + key); _removeChild(body, idx); continue; }
    var cells = [t.headers].concat(t.rows).map(function (r) { return r.map(function (c) { return String(c == null ? '' : c); }); });
    var table = body.insertTable(idx + 1, cells);
    styleTable_(table, null);
    _removeChild(body, idx);
  }
}

/** Every table's first row: brand background, white bold text (colour from Master Sheet brand_table_header_bg). */
function styleAllTableHeaders_(body, bg) {
  body.getTables().forEach(function (t) {
    if (t.getNumRows() < 2) return;
    var row = t.getRow(0);
    for (var c = 0; c < row.getNumCells(); c++) {
      row.getCell(c).setBackgroundColor(bg).editAsText().setForegroundColor('#ffffff').setBold(true);
    }
  });
}

function styleTable_(table) {
  table.setBorderColor(TABLE_STYLE.border);
  for (var r = 0; r < table.getNumRows(); r++) {
    var row = table.getRow(r);
    for (var c = 0; c < row.getNumCells(); c++) {
      var cell = row.getCell(c);
      cell.setPaddingTop(3).setPaddingBottom(3);
      var txt = cell.editAsText().setFontFamily(TABLE_STYLE.font).setFontSize(TABLE_STYLE.size);
      if (r === 0) { cell.setBackgroundColor(TABLE_STYLE.headerBg); txt.setForegroundColor(TABLE_STYLE.headerFg).setBold(true); }
      if (c > 0) cell.getChild(0).asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);
    }
  }
}

function applyImages_(sec, images) {
  var f;
  var guard = 0;
  while ((f = sec.findText('\\{\\{IMAGE:\\w+\\}\\}')) && guard++ < 20) {
    var el = f.getElement().asText();
    var tok = el.getText().slice(f.getStartOffset(), f.getEndOffsetInclusive() + 1);
    var key = tok.match(/IMAGE:(\w+)/)[1];
    el.deleteText(f.getStartOffset(), f.getEndOffsetInclusive());
    if (!images[key]) continue;
    var par = el.getParent();
    while (par.getType() !== DocumentApp.ElementType.PARAGRAPH) par = par.getParent();
    var img = par.asParagraph().insertInlineImage(0, DriveApp.getFileById(images[key]).getBlob());
    var w = img.getWidth(), h = img.getHeight(), maxW = key === 'OptCultureLogo' ? 200 : 120;
    if (w > maxW) img.setWidth(maxW).setHeight(Math.round(h * maxW / w));
  }
}

// ---------------- text replacement ----------------

/** Replace every literal occurrence of token (no regex/`$` surprises in values). */
function replaceLiteral_(el, token, value) {
  var pattern = token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  var v = String(value == null ? '' : value);
  var f, guard = 0;
  while ((f = el.findText(pattern)) && guard++ < 1000) {
    var t = f.getElement().asText();
    var s = f.getStartOffset();
    t.deleteText(s, f.getEndOffsetInclusive());
    if (v) t.insertText(s, v);
  }
}

/** Any {{…}} left after filling is highlighted yellow and reported. */
function highlightLeftovers_(sec) {
  var out = [];
  var f = sec.findText('\\{\\{[^}]+\\}\\}');
  while (f) {
    var t = f.getElement().asText();
    t.setBackgroundColor(f.getStartOffset(), f.getEndOffsetInclusive(), '#fff59d');
    out.push('Unfilled placeholder: ' + t.getText().slice(f.getStartOffset(), f.getEndOffsetInclusive() + 1));
    f = sec.findText('\\{\\{[^}]+\\}\\}', f);
  }
  return out;
}

function addDraftBanner_(doc) {
  var header = doc.getHeader() || doc.addHeader();
  var p = header.insertParagraph(0, 'DRAFT – PENDING APPROVAL – NOT FOR CLIENT USE');
  p.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  p.editAsText().setBold(true).setForegroundColor('#c62828').setFontSize(10);
}

// ===================== SetupMasterSheet.js =====================
/**
 * Sprint 1.1 + 2: one-time setup. Run from the Apps Script editor (as docs-admin@ or Varaprasad) after
 * setting the Script Property ROOT_FOLDER_ID to the folder / Shared Drive Amith shares.
 *
 *   setupFolders()      – creates the folder structure inside ROOT_FOLDER_ID (idempotent)
 *   setupMasterSheet()  – creates the Master DB spreadsheet with all tabs, headers and seed data (idempotent:
 *                         existing tabs that already contain data are NOT overwritten)
 */

function setupAll() {
  setupFolders();
  setupMasterSheet();
}

function getRootFolder_() {
  var id = getProp_('ROOT_FOLDER_ID');
  if (!id) throw new Error('Set Script Property ROOT_FOLDER_ID first.');
  return DriveApp.getFolderById(id);
}

function getOrCreateFolder_(parent, name) {
  var it = parent.getFoldersByName(name);
  return it.hasNext() ? it.next() : parent.createFolder(name);
}

function setupFolders() {
  var root = getRootFolder_();
  var ids = {};
  Object.keys(CONFIG.FOLDERS).forEach(function (k) {
    ids[k] = getOrCreateFolder_(root, CONFIG.FOLDERS[k]).getId();
    setProp_('FOLDER_' + k, ids[k]);
  });
  console.log('Folders ready: ' + JSON.stringify(ids));
  return ids;
}

function setupMasterSheet() {
  var ss;
  var id = getProp_('MASTER_SHEET_ID');
  if (id) {
    ss = SpreadsheetApp.openById(id);
  } else {
    ss = SpreadsheetApp.create(CONFIG.MASTER_SHEET_NAME);
    var folderId = getProp_('FOLDER_MASTER_DB');
    if (folderId) DriveApp.getFileById(ss.getId()).moveTo(DriveApp.getFolderById(folderId));
    setProp_('MASTER_SHEET_ID', ss.getId());
  }

  Object.keys(SEED).forEach(function (tab) {
    var def = SEED[tab];
    var sh = ss.getSheetByName(tab) || ss.insertSheet(tab);
    if (sh.getLastRow() > 1) { console.log(tab + ': has data, skipped'); return; }
    sh.clear();
    sh.getRange(1, 1, 1, def.headers.length).setValues([def.headers])
      .setFontWeight('bold').setBackground(def.kind === 'master' ? '#1f3b57' : '#5b6b7a').setFontColor('#ffffff');
    sh.setFrozenRows(1);
    if (def.rows && def.rows.length) {
      sh.getRange(2, 1, def.rows.length, def.headers.length).setValues(def.rows.map(function (r) { return r.map(asSheetValue_); }));
    }
    sh.autoResizeColumns(1, def.headers.length);
    sh.setTabColor(def.kind === 'master' ? '#1f3b57' : '#9aa5b1');
  });

  var blank = ss.getSheetByName('Sheet1');
  if (blank && ss.getSheets().length > 1) ss.deleteSheet(blank);

  writeSchemaReadme_(ss);
  protectMasterTabs_(ss);
  clearMasterCache();
  console.log('Master Sheet ready: ' + ss.getUrl());
  return ss.getUrl();
}

/** Keep phone numbers ("+91 …") and percentages ("99.9%") as text — Sheets would otherwise parse them as formulas/numbers. */
function asSheetValue_(v) {
  return (typeof v === 'string' && (/^[+=\-]/.test(v) || /%$/.test(v))) ? "'" + v : v;
}

function writeSchemaReadme_(ss) {
  var sh = ss.getSheetByName('README') || ss.insertSheet('README', 0);
  sh.clear();
  var rows = [['Tab', 'Type', 'Columns']];
  Object.keys(SEED).forEach(function (t) { rows.push([t, SEED[t].kind, SEED[t].headers.join(', ')]); });
  sh.getRange(1, 1, rows.length, 3).setValues(rows);
  sh.getRange(1, 1, 1, 3).setFontWeight('bold');
  sh.setColumnWidth(3, 900);
}

/** Master tabs: editable only by the script owner and superadmins. Records: owner only (the app writes them). */
function protectMasterTabs_(ss) {
  var admins = SEED.Users.rows.filter(function (r) { return r[2] === CONFIG.ROLES.SUPERADMIN; }).map(function (r) { return r[0]; });
  Object.keys(SEED).forEach(function (tab) {
    var sh = ss.getSheetByName(tab);
    sh.getProtections(SpreadsheetApp.ProtectionType.SHEET).forEach(function (p) { p.remove(); });
    var p = sh.protect().setDescription('Managed by ' + CONFIG.APP_NAME);
    p.removeEditors(p.getEditors());
    if (SEED[tab].kind === 'master') { try { p.addEditors(admins); } catch (e) { console.warn(e); } }
  });
}

